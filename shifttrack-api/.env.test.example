# Test database — copy to .env.test (git-ignored).
# The suite DROPS AND RECREATES this schema on every run. Separate database
# from shifttrack_dev on purpose, so tests never wipe what you were poking at.

# Local Postgres from docker-compose.yml (port 5433, NOT 5432).
DATABASE_URL=postgresql://shifttrack:localdev@localhost:5433/shifttrack_test

# Throwaway local values. These are not secrets; they only sign tokens
# that only this machine's sandbox will ever accept.
JWT_SECRET=local-dev-only-not-a-real-secret
ADMIN_KEY=local-admin-key

# Generate your own with:  npx web-push generate-vapid-keys
# Required even locally: utils/webpush.js calls setVapidDetails at module
# load, so the API will not boot without a valid-format key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:local@shifttrack.test

NODE_ENV=test
PORT=3101
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Raise the auth rate limit: the suite logs in many times from one IP.
AUTH_RATE_LIMIT=1000
