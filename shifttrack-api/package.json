{
  "name": "shifttrack-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:local": "node --env-file=.env.local server.js",
    "web": "node scripts/serve-web.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:seed": "node --env-file=.env.local scripts/seed.js",
    "db:reset": "node --env-file=.env.local scripts/reset-db.js",
    "db:psql": "docker compose exec db psql -U shifttrack -d shifttrack_dev",
    "test": "npm run test:syntax && npm run test:api",
    "test:syntax": "node scripts/check-syntax.js",
    "test:api": "node --env-file=.env.test --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "verify:rls": "node scripts/verify-rls.js",
    "migrate:rls": "node scripts/apply-rls.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
